/**
 * QWeather `icon` ID → WMO code mapping (接口文档 §4.3).
 * Incomplete on purpose: extend the table and verify against QWeather docs
 * before enabling the source (隐私文档 §3.1 gate).
 */
const QW_TO_WMO: Record<string, number> = {
  '100': 0, '150': 0,
  '102': 1, '152': 1,
  '101': 2, '103': 2, '151': 2, '153': 2,
  '104': 3, '154': 3, '200': 3,
  '300': 61, '305': 61, '309': 51, '310': 63, '311': 63,
  '301': 63, '306': 63,
  '302': 65, '307': 65, '308': 65, '312': 65,
  '303': 80, '304': 82,
  '313': 66,
  '314': 71, '317': 71, '400': 71,
  '315': 73, '316': 73, '318': 73, '320': 73, '399': 73, '401': 73, '405': 73, '406': 85,
  '402': 75, '403': 75, '404': 73,
  '407': 85,
  '500': 45, '509': 45, '510': 45, '511': 45, '512': 45, '513': 45, '514': 45, '515': 45, '501': 45,
  '502': 3, '503': 3, '504': 3, '507': 3, '508': 3,
  '900': 0, '901': 3,
  '999': 3
};

export function qweatherIconToWmo(icon: string): number {
  const code: number | undefined = QW_TO_WMO[icon];
  return code ?? 3;
}
