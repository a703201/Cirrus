import { MaterialUtil } from './MaterialUtil';
import { GradientText } from './GradientText';
import { wmoIconKey } from '../models/WmoCode';

/**
 * Hero å¤©æ°”å¡ï¼ˆå·äº‘Â·æ°”è±¡æ‹ŸçœŸï¼Œdocs/13 Â§7ï¼‰.
 * - å†…å®¹å¡é‡‡ç”¨ç¨³å®šç»ç’ƒï¼ˆImmersiveMaterial å¯¹å†…å®¹åŒºä¸ç”Ÿæ•ˆï¼‰ã€‚
 * - æ¸©åº¦ï¼šæ•°å­—ç¿»ç‰Œ + æ¸å˜å­—ï¼›å¤©æ°”å›¾æ ‡ï¼šweather-icons å­—ä½“å›¾ï¼ˆcommon mediaï¼‰ã€‚
 * - ç‰ˆå¼ï¼šåœ°ç‚¹ â†’ å¤§æ¸©åº¦+å›¾æ ‡ â†’ ç°è±¡ â†’ é«˜ä½æ¸©/ä½“æ„Ÿ â†’ æ›´æ–°æ—¶é—´ï¼ˆæ¸…æ™°è§†è§‰å±‚çº§ï¼‰ã€‚
 */
@ComponentV2
export struct WeatherCard {
  @Param temperature: number = 0;
  @Param unit: TemperatureUnit = TemperatureUnit.CELSIUS;
  @Param condition: string = '';
  @Param locationName: ResourceStr = '';
  @Param updatedAt: string = '';
  @Param weatherCode: number = 0;
  @Param isDay: boolean = true;
  @Param materialTier: MaterialTier = MaterialTier.AUTO;
  @Param high: number = -999;
  @Param low: number = -999;
  @Param apparent: number = -999;

  private convert(v: number): number {
    return this.unit === TemperatureUnit.FAHRENHEIT ? Math.round(v * 9 / 5 + 32) : Math.round(v);
  }

  private tempText(): string {
    return `${this.convert(this.temperature)}Â°`;
  }

  /**
   * å¤©æ°”å›¾æ ‡èµ„æºï¼šæ–‡ä»¶å = `wx_<base>_<day|night>`ï¼Œä¸ `wmoIconKey()` è¾“å‡ºä¸€è‡´ï¼Œ
   * èµ„æºç½®äº common æ¨¡å— mediaï¼ˆerikflowers/weather-iconsï¼ŒMITï¼Œè§ READMEï¼‰ã€‚
   */
  private iconResource(): Resource {
    const key: string = wmoIconKey(this.weatherCode, this.isDay);
    return $r('common.media.' + key);
  }

  build() {
    Column({ space: 2 }) {
      Text(this.locationName)
        .fontSize(17)
        .fontWeight(FontWeight.Medium)
        .fontColor('#1A1A1A')
        .maxLines(1)
        .textOverflow({ overflow: TextOverflow.Ellipsis })

      Row({ space: 12 }) {
        Image(this.iconResource())
          .width(52)
          .height(52)
          .fillColor(this.isDay ? '#3B82F6' : '#7EA6F0')
        GradientText({
          text: this.tempText(),
          fontSize: 88,
          fontWeight: FontWeight.Lighter,
          colors: this.isDay ? ['#1A1A1A', '#3B82F6'] : ['#F2F2F2', '#7EA6F0']
        })
      }
      .alignItems(VerticalAlign.Center)
      .margin({ top: 2 })

      Text(this.condition)
        .fontSize(17)
        .fontColor('#3F3F3F')
        .letterSpacing(0.3)

      if (this.high > -900 && this.low > -900) {
        Row({ space: 12 }) {
          Text(`â†‘ ${this.convert(this.high)}Â°`).fontSize(14).fontColor('#3F3F3F')
          Text(`â†“ ${this.convert(this.low)}Â°`).fontSize(14).fontColor('#3F3F3F')
          if (this.apparent > -900) {
            Text(`ï½œ ${this.convert(this.apparent)}Â°`).fontSize(14).fontColor('#595959')
          }
        }
        .margin({ top: 8 })
      }

      if (this.updatedAt.length > 0) {
        Text(this.updatedAt)
          .fontSize(12)
          .fontColor('#6B6B6B')
          .margin({ top: 8 })
      }
    }
    .width('100%')
    .padding({ top: 26, bottom: 26, left: 20, right: 20 })
    .backgroundColor('rgba(255,255,255,0.38)')
    .backgroundBlurStyle(MaterialUtil.cardBlurStyle(this.materialTier))
    .borderRadius(28)
    .accessibilityGroup(true)
    .accessibilityText(`${this.tempText()} ${this.condition}`)
  }
}
