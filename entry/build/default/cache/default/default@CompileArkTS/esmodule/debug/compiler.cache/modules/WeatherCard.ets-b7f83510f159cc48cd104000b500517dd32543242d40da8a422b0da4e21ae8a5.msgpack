jimport { TemperatureUnit, MaterialTier } from '../models/Settings';
import { MaterialUtil } from './MaterialUtil';
import { GradientText } from './GradientText';
import { wmoIconKey } from '../models/WmoCode';

/**
 * Reusable current-weather card (state management V2).
 * å·äº‘Â·æ°”è±¡æ‹ŸçœŸï¼ˆdocs/13 Â§7ï¼‰ï¼šå†…å®¹å¡é‡‡ç”¨ç¨³å®šç»ç’ƒï¼ˆ`backgroundBlurStyle`ï¼‰â€”â€”å› å®˜æ–¹çº¦æŸ
 * ImmersiveMaterial å¯¹å†…å®¹åŒºä¸ç”Ÿæ•ˆï¼›æ²‰æµ¸å…‰æ„Ÿèšç„¦äºæ ‡é¢˜æ /åº•éƒ¨å¯¼èˆª/å¼¹çª—ã€‚
 * æ¸©åº¦ä½¿ç”¨æ•°å­—ç¿»ç‰Œ + æ¸å˜å­—ï¼ˆP1-4ï¼‰ï¼›å¤©æ°”å›¾æ ‡ä½¿ç”¨ erikflowers/weather-iconsï¼ˆMITï¼Œ
 * è§ READMEï¼‰ï¼Œèµ„æºç½®äº common æ¨¡å— mediaï¼Œæ–‡ä»¶åä¸ `wmoIconKey()` è¾“å‡ºä¸€ä¸€å¯¹åº”ã€‚
 */
@ComponentV2
export struct WeatherCard {
  @Param temperature: number = 0;
  @Param unit: TemperatureUnit = TemperatureUnit.CELSIUS;
  @Param condition: string = '';
  @Param locationName: ResourceStr = '';
  @Param updatedAt: string = '';
  @Param weatherCode: number = 0;
  @Param isDay: boolean = true;
  @Param materialTier: MaterialTier = MaterialTier.AUTO;

  private tempText(): string {
    const c: number = this.unit === TemperatureUnit.FAHRENHEIT
      ? Math.round(this.temperature * 9 / 5 + 32)
      : Math.round(this.temperature);
    return `${c}Â°`;
  }

  /**
   * å¤©æ°”å›¾æ ‡èµ„æºï¼šæ–‡ä»¶å = `wx_<base>_<day|night>`ï¼Œä¸ `wmoIconKey()` è¾“å‡ºä¸€è‡´ï¼Œ
   * èµ„æºç½®äº common æ¨¡å— mediaï¼ˆæ¥è‡ª erikflowers/weather-iconsï¼ŒMITï¼Œè§ READMEï¼‰ã€‚
   */
  private iconResource(): Resource {
    const key: string = wmoIconKey(this.weatherCode, this.isDay);
    return $r('common.media.' + key);
  }

  build() {
    Column() {
      Text(this.locationName)
        .fontSize(18)
        .fontWeight(FontWeight.Medium)
        .fontColor('#1A1A1A')
      Row({ space: 8 }) {
        Image(this.iconResource())
          .width(44)
          .height(44)
          .fillColor(this.isDay ? '#3B82F6' : '#7EA6F0')
        GradientText({
          text: this.tempText(),
          fontSize: 72,
          fontWeight: FontWeight.Lighter,
          colors: this.isDay ? ['#1A1A1A', '#3B82F6'] : ['#F2F2F2', '#7EA6F0']
        })
      }
      .alignItems(VerticalAlign.Center)
      .margin({ top: 6, bottom: 4 })
      Text(this.condition)
        .fontSize(16)
        .fontColor('#4A4A4A')
      if (this.updatedAt.length > 0) {
        Text(this.updatedAt)
          .fontSize(12)
          .fontColor('#6B6B6B')
          .margin({ top: 8 })
      }
    }
    .width('100%')
    .padding(20)
    .backgroundColor('rgba(255,255,255,0.35)')
    .backgroundBlurStyle(MaterialUtil.cardBlurStyle(this.materialTier))
    .borderRadius(24)
  }
}
