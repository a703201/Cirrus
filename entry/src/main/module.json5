{"module": {"name": "entry", "type": "entry", "description": "$string:module_desc", "mainElement": "EntryAbility", "deviceTypes": ["phone", "tablet", "2in1", "tv"], "deliveryWithInstall": true, "metadata": [{"name": "ohos.arkui.UIMaterial.state", "value": "enable"}], "pages": "$profile:main_pages", "abilities": [{"name": "EntryAbility", "srcEntry": "./ets/entryability/EntryAbility.ets", "description": "$string:entry_desc", "icon": "$media:app_icon", "label": "$string:app_name", "startWindowIcon": "$media:app_icon", "startWindowBackground": "$color:start_window_background", "exported": true, "skills": [{"entities": ["entity.system.home"], "actions": ["action.system.home"]}]}], "extensionAbilities": [{"name": "WeatherFormAbility", "srcEntry": "./ets/features/widget/WeatherFormAbility.ets", "description": "$string:form_desc", "label": "$string:app_name", "type": "form", "exported": true, "metadata": [{"name": "ohos.extension.form", "resource": "$profile:form_config"}]}],
  "requestPermissions": [
    {
      "name": "ohos.permission.INTERNET",
      "reason": "$string:perm_internet",
      "usedScene": {
        "when": "always",
        "abilities": [
          "EntryAbility"
        ]
      }
    },
    {
      "name": "ohos.permission.LOCATION",
      "reason": "$string:perm_location",
      "usedScene": {
        "when": "inuse",
        "abilities": [
          "EntryAbility"
        ]
      }
    },
    {
      "name": "ohos.permission.APPROXIMATELY_LOCATION",
      "reason": "$string:perm_location",
      "usedScene": {
        "when": "inuse",
        "abilities": [
          "EntryAbility"
        ]
      }
    }
  ]
}}